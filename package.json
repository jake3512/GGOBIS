{
  "name": "semips",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "prisma migrate dev",
    "db:sync-champions": "dotenv -e .env -- tsx scripts/syncChampions.ts",
    "db:seed-sample": "dotenv -e .env -- tsx scripts/seedSampleData.ts",
    "collect": "dotenv -e .env -- tsx scripts/collectMatches.ts",
    "vercel-build": "prisma generate && prisma migrate deploy && tsx scripts/syncChampions.ts && tsx scripts/seedSampleData.ts && next build"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "16.3.1",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
