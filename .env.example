# SQLite database file used by Prisma. Relative paths resolve against
# prisma/schema.prisma's location, so this actually creates prisma/dev.db.
DATABASE_URL="file:./dev.db"

# Riot Games API key from https://developer.riot.com/
# A personal dev key expires every 24h and is rate-limited (~20 req/s, 100 req/2min) —
# only needed for `npm run collect`. Not required to run the app itself.
RIOT_API_KEY=""
